{
  "name": "@zipzap/repository",
  "version": "0.0.0",
  "private": true,
  "description": "Documentation and repository checks for ZipZap; not the application package.",
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "format": "prettier --write .",
    "check:format": "prettier --check .",
    "check:links": "node scripts/check-links.mjs",
    "test": "node --test scripts/check-links.test.mjs scripts/prepare-performance-history.test.mjs",
    "check": "npm run check:format && npm run check:links && npm test && npm run check:ui",
    "dev": "npm run dev --workspace @zipzap/desktop",
    "build:web": "npm run build --workspace @zipzap/desktop",
    "check:ui": "npm run check --workspace @zipzap/desktop",
    "desktop:dev": "npm run tauri --workspace @zipzap/desktop -- dev",
    "desktop:build": "node scripts/build-native.mjs && npm run tauri --workspace @zipzap/desktop -- build --bundles nsis",
    "build:extension": "node scripts/build-extension.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@types/chrome": "0.3.5",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1"
  },
  "workspaces": [
    "apps/desktop"
  ]
}
