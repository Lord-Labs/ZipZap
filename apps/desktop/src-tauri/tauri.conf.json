{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZipZap",
  "version": "0.1.0-beta.1",
  "identifier": "com.zipzap.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ZipZap",
        "width": 1200,
        "height": 800,
        "minWidth": 780,
        "minHeight": 560,
        "backgroundColor": "#242424",
        "additionalBrowserArgs": "--force-renderer-accessibility"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; base-uri 'none'; frame-src 'none'",
      "devCsp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 ws://127.0.0.1:1420; img-src 'self' data:; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Utility",
    "shortDescription": "Fast, reliable downloads. Yours to keep.",
    "license": "MIT",
    "externalBin": ["binaries/zipzap-native"],
    "resources": {
      "../../../dist/release/THIRD_PARTY_LICENSES.txt": "THIRD_PARTY_LICENSES.txt",
      "../../../dist/release/sources/*": "third-party-sources/"
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Arabic"],
        "displayLanguageSelector": true,
        "installerHooks": "installer/hooks.nsh"
      }
    }
  }
}
